# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard). Both are safe to
# expose in the client — security is enforced by the RLS policies in
# supabase/schema.sql, not by hiding these.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
